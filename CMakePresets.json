{
  "version": 6,
  "cmakeMinimumRequired": { "major": 3, "minor": 25, "patch": 0 },
  "configurePresets": [
    {
      "name": "msvc",
      "displayName": "MSVC x64",
      "description": "Same build tree as the README's command line build. Change CMAKE_PREFIX_PATH in a CMakeUserPresets.json if Qt lives elsewhere.",
      "generator": "Visual Studio 17 2022",
      "architecture": "x64",
      "binaryDir": "${sourceDir}/build",
      "cacheVariables": {
        "CMAKE_PREFIX_PATH": "G:/Qt/6.7.3/msvc2019_64",
        "CANTRIP_BUILD_TESTS": "ON"
      }
    }
  ],
  "buildPresets": [
    { "name": "release", "displayName": "Release", "configurePreset": "msvc", "configuration": "Release" },
    { "name": "debug", "displayName": "Debug", "configurePreset": "msvc", "configuration": "Debug" }
  ],
  "testPresets": [
    {
      "name": "release",
      "displayName": "Unit tests (Release)",
      "configurePreset": "msvc",
      "configuration": "Release",
      "output": { "outputOnFailure": true }
    },
    {
      "name": "debug",
      "displayName": "Unit tests (Debug)",
      "configurePreset": "msvc",
      "configuration": "Debug",
      "output": { "outputOnFailure": true }
    }
  ]
}
